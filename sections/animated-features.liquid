<style>
  .animated-features-section-{{ section.id }} {
    padding: 80px 20px;
    background: {{ section.settings.background_color }};
    margin: 0;
    overflow: hidden;
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .features-heading {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    margin-bottom: 16px;
    color: {{ section.settings.heading_color }};
  }

  .features-description {
    font-size: clamp(16px, 2vw, 20px);
    color: {{ section.settings.text_color }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-top: 50px;
  }

  .feature-card {
    background: {{ section.settings.card_bg_color }};
    padding: 40px 30px;
    border-radius: 12px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }

  .feature-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.15);
  }

  .feature-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.icon_bg_color }};
    border-radius: 50%;
    font-size: 36px;
  }

  .feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .feature-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
    color: {{ section.settings.card_text_color }};
  }

  .feature-description {
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.card_text_color }};
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .animated-features-section-{{ section.id }} {
      padding: 60px 15px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .feature-card {
      padding: 30px 20px;
    }
  }
</style>

<section class="animated-features-section-{{ section.id }}">
  <div class="features-container">
    <div class="features-header">
      {% if section.settings.heading != blank %}
        <h2 class="features-heading gsap-zoom-in wow animate__animated">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="features-description gsap-fade-in wow animate__animated">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="features-grid">
      {% for block in section.blocks %}
        <div class="feature-card wow animate__animated" {{ block.shopify_attributes }}>
          {% if block.settings.icon_image != blank %}
            <div class="feature-icon">
              {{
                block.settings.icon_image
                | image_url: width: 80
                | image_tag: loading: 'lazy', class: 'gsap-slide-left'
              }}
            </div>
          {% elsif block.settings.icon_text != blank %}
            <div class="feature-icon">{{ block.settings.icon_text }}</div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="feature-title gsap-fade-in">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="feature-description gsap-fade-in">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Animated Features",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Us"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover what makes us special"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Background Color",
      "default": "#e8e8e8"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon Text (emoji or symbol)",
          "default": "⭐"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Animated Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_text": "🚀",
            "title": "Fast Delivery",
            "description": "Quick and reliable shipping"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_text": "💎",
            "title": "Premium Quality",
            "description": "Only the best products"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_text": "❤️",
            "title": "Customer Support",
            "description": "24/7 dedicated support"
          }
        }
      ]
    }
  ]
}
{% endschema %}

