<style>
  .animated-parallax-section-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    background: {{ section.settings.background_color }};
  }

  .parallax-container {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1400px;
    margin: 0 auto;
    z-index: 2;
  }

  .parallax-background {
    position: absolute;
    top: -20%;
    left: 0;
    width: 100%;
    height: 140%;
    z-index: 0;
    will-change: transform;
  }

  .parallax-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness({{ section.settings.image_brightness | divided_by: 100.0 }});
  }

  .parallax-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .parallax-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .parallax-heading {
    font-size: clamp(32px, 6vw, 64px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 24px;
    color: {{ section.settings.heading_color }};
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    letter-spacing: -1px;
  }

  .parallax-subheading {
    font-size: clamp(18px, 3vw, 28px);
    font-weight: 400;
    line-height: 1.6;
    margin-bottom: 40px;
    color: {{ section.settings.text_color }};
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .parallax-button {
    display: inline-block;
    padding: 18px 45px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    border-radius: 50px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
  }

  .parallax-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .parallax-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
    background: {{ section.settings.button_hover_background }};
  }

  .parallax-button:hover::before {
    width: 300px;
    height: 300px;
  }

  .parallax-button span {
    position: relative;
    z-index: 1;
  }

  /* Floating elements for depth */
  .parallax-floating-1,
  .parallax-floating-2,
  .parallax-floating-3 {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    z-index: 1;
  }

  .parallax-floating-1 {
    width: 200px;
    height: 200px;
    top: 10%;
    left: 5%;
    animation: float1 20s ease-in-out infinite;
  }

  .parallax-floating-2 {
    width: 150px;
    height: 150px;
    bottom: 15%;
    right: 8%;
    animation: float2 25s ease-in-out infinite;
  }

  .parallax-floating-3 {
    width: 100px;
    height: 100px;
    top: 50%;
    right: 15%;
    animation: float3 18s ease-in-out infinite;
  }

  @keyframes float1 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(30px, -30px) rotate(180deg); }
  }

  @keyframes float2 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-25px, 25px) rotate(-180deg); }
  }

  @keyframes float3 {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(20px, -20px) rotate(180deg); }
  }

  @media (max-width: 768px) {
    .animated-parallax-section-{{ section.id }} {
      min-height: 500px;
      padding: 60px 15px;
    }

    .parallax-content {
      padding: 30px 15px;
    }

    .parallax-heading {
      margin-bottom: 20px;
    }

    .parallax-subheading {
      margin-bottom: 30px;
    }

    .parallax-button {
      padding: 16px 35px;
      font-size: 14px;
    }

    .parallax-floating-1,
    .parallax-floating-2,
    .parallax-floating-3 {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .animated-parallax-section-{{ section.id }} {
      min-height: 400px;
      padding: 40px 15px;
    }
  }
</style>

<section class="animated-parallax-section-{{ section.id }} parallax-container">
  {% if section.settings.background_image != blank %}
    <div class="parallax-background parallax-bg">
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag: loading: 'lazy', alt: section.settings.heading | default: 'Parallax background', class: 'parallax-bg-image'
      }}
    </div>
  {% endif %}

  <div class="parallax-overlay"></div>

  <div class="parallax-floating-1"></div>
  <div class="parallax-floating-2"></div>
  <div class="parallax-floating-3"></div>

  <div class="parallax-content parallax-text">
    {% if section.settings.heading != blank %}
      <h2 class="parallax-heading wow animate__animated">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="parallax-subheading wow animate__animated">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="parallax-button gsap-bounce-hover">
        <span>{{ section.settings.button_text }}</span>
      </a>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.animated-parallax-section-{{ section.id }}');
    if (!section) return;

    // GSAP Parallax Effects
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        // Parallax background image
        const bgImage = section.querySelector('.parallax-background');
        if (bgImage) {
          gsap.to(bgImage, {
            yPercent: 30,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 1.5,
              invalidateOnRefresh: true
            }
          });
        }

        // Parallax text content (moves opposite direction for depth)
        const content = section.querySelector('.parallax-content');
        if (content) {
          gsap.to(content, {
            yPercent: -10,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 1.5,
              invalidateOnRefresh: true
            }
          });
        }

        // Floating elements parallax
        const floating1 = section.querySelector('.parallax-floating-1');
        const floating2 = section.querySelector('.parallax-floating-2');
        const floating3 = section.querySelector('.parallax-floating-3');

        if (floating1) {
          gsap.to(floating1, {
            yPercent: 15,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 2,
              invalidateOnRefresh: true
            }
          });
        }

        if (floating2) {
          gsap.to(floating2, {
            yPercent: -20,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 2,
              invalidateOnRefresh: true
            }
          });
        }

        if (floating3) {
          gsap.to(floating3, {
            yPercent: 25,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 2,
              invalidateOnRefresh: true
            }
          });
        }
      }

      // Fade in animations on scroll
      const heading = section.querySelector('.parallax-heading');
      const subheading = section.querySelector('.parallax-subheading');
      const button = section.querySelector('.parallax-button');

      if (heading) {
        gsap.fromTo(
          heading,
          { opacity: 0, y: 50, scale: 0.9 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 1,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: heading,
              start: 'top 80%',
              toggleActions: 'play none none none',
              once: true
            }
          }
        );
      }

      if (subheading) {
        gsap.fromTo(
          subheading,
          { opacity: 0, y: 30 },
          {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power3.out',
            delay: 0.2,
            scrollTrigger: {
              trigger: subheading,
              start: 'top 80%',
              toggleActions: 'play none none none',
              once: true
            }
          }
        );
      }

      if (button) {
        gsap.fromTo(
          button,
          { opacity: 0, y: 20, scale: 0.8 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.6,
            ease: 'back.out(1.7)',
            delay: 0.4,
            scrollTrigger: {
              trigger: button,
              start: 'top 80%',
              toggleActions: 'play none none none',
              once: true
            }
          }
        );
      }
    }
  });
</script>

{% schema %}
{
  "name": "Animated Parallax Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience the Future"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover innovative solutions that transform your business and elevate your success to new heights."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "image_brightness",
      "label": "Image Brightness",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Style Settings"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button Hover Background",
      "default": "#f5f5f5"
    }
  ],
  "presets": [
    {
      "name": "Animated Parallax Section"
    }
  ]
}
{% endschema %}
