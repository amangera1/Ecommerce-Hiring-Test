<style>
  .animated-product-slider-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    /* background: linear-gradient(to bottom, #f5f5f5 0%, #1a4d5c 100%); */
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  .product-slider-header {
    background: #ffffff;
    padding: 40px 0 0;
    margin: -{{ section.settings.padding_top }}px -20px {{ section.settings.header_spacing }}px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .product-slider-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .product-slider-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: {{ section.settings.header_spacing }}px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .product-slider-header-content {
    flex: 1;
    min-width: 300px;
  }

  .product-slider-heading {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    margin-bottom: 16px;
    color: {{ section.settings.heading_color }};
    line-height: 1.3;
    text-align: left;
  }

  .product-slider-description {
    font-size: clamp(16px, 2vw, 20px);
    color: {{ section.settings.text_color }};
    line-height: 1.6;
    max-width: 800px;
    text-align: left;
  }

  .product-slider-view-all {
    display: inline-flex;
    align-items: center;
    font-size: 16px;
    font-weight: 600;
    color: {{ section.settings.view_all_color }};
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
    padding: 10px 0;
  }

  .product-slider-view-all:hover {
    color: {{ section.settings.view_all_hover_color }};
    text-decoration: underline;
  }

  .product-slider {
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: {{ section.settings.slide_gap }}px;
    flex-wrap: wrap;
  }

  .product-slide {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.card_border_radius }}px;
    background: transparent;
    box-shadow: none;
    transition: transform 0.3s ease;
    flex: 1;
    min-width: calc((100% - ({{ section.settings.slides_per_view }} - 1) * {{ section.settings.slide_gap }}px) / {{ section.settings.slides_per_view }});
    max-width: calc((100% - ({{ section.settings.slides_per_view }} - 1) * {{ section.settings.slide_gap }}px) / {{ section.settings.slides_per_view }});
    display: flex;
    flex-direction: column;
  }

  .product-slide:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }

  .product-slide-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    background: #f5f5f5;
    display: flex;
    align-items: flex-end;
  }

  .product-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .product-slide:hover .product-slide-image {
    transform: scale(1.1) !important;
  }

  .product-slide-content-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 30px 25px;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
  }

  .product-slide-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    margin: 0 0 15px 0;
    color: #ffffff;
    text-align: left;
    padding: 0;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .product-slide-view-all-overlay {
    position: relative;
    z-index: 2;
  }

  .product-slide-view-all-btn {
    display: inline-block;
    color: #0066cc;
    font-size: 16px;
    font-weight: 600;
    text-decoration: underline;
    transition: all 0.3s ease;
    background: transparent;
    padding: 0;
    border: none;
    cursor: pointer;
  }

  .product-slide-view-all-btn:hover {
    color: #0052a3;
    text-decoration: underline;
  }


  /* Animation Classes - Section specific to avoid conflicts */
  .animated-product-slider-{{ section.id }} .animate-from-left,
  .animated-product-slider-{{ section.id }} .animate-from-right,
  .animated-product-slider-{{ section.id }} .animate-from-bottom,
  .animated-product-slider-{{ section.id }} .animate-zoom-in,
  .animated-product-slider-{{ section.id }} .animate-fade {
    /* GSAP will handle opacity and transforms */
  }

  @media (max-width: 1024px) {
    .product-slider-container {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .animated-product-slider-{{ section.id }} {
      padding: 60px 15px 60px;
    }

    .product-slider-header {
      margin-bottom: 30px;
      flex-direction: column;
    }

    .product-slider-header-content {
      width: 100%;
    }

    .product-slider-view-all {
      align-self: flex-start;
    }

    .product-slider-button-next,
    .product-slider-button-prev {
      width: 40px;
      height: 40px;
    }

    .product-slider{
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .product-slider-button-next,
    .product-slider-button-prev {
      display: none;
    }
  }
</style>

<section class="animated-product-slider-{{ section.id }}">
  <div class="product-slider-container">
    <div class="product-slider-header">
      <div class="product-slider-header-content">
        {% if section.settings.heading != blank %}
          <h2 class="product-slider-heading animate-{{ section.settings.heading_animation }} wow animate__animated">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="product-slider-description animate-{{ section.settings.description_animation }} wow animate__animated">
            {{ section.settings.description }}
          </p>
        {% endif %}
      </div>
      {% if section.settings.view_all_text != blank and section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="product-slider-view-all animate-{{ section.settings.view_all_animation }} wow animate__animated">
          {{ section.settings.view_all_text }}
        </a>
      {% endif %}
    </div>

    <div class="product-slider" id="product-slider-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="product-slide animate-{{ block.settings.slide_animation | default: section.settings.default_slide_animation }} wow animate__animated" {{ block.shopify_attributes }}>
          <div class="product-slide-image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: class: 'product-slide-image', loading: 'lazy', alt: block.settings.title
              }}
            {% endif %}
            <div class="product-slide-content-overlay">
              {% if block.settings.title != blank %}
                <h3 class="product-slide-title animate-{{ block.settings.slide_animation | default: section.settings.default_slide_animation }}">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.view_all_text != blank and block.settings.view_all_link != blank %}
                <div class="product-slide-view-all-overlay">
                  <a href="{{ block.settings.view_all_link }}" class="product-slide-view-all-btn animate-{{ block.settings.slide_animation | default: section.settings.default_slide_animation }}">
                    {{ block.settings.view_all_text }}
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sliderEl = document.getElementById('product-slider-{{ section.id }}');
    if (!sliderEl || typeof gsap === 'undefined') return;

    // Animation function using GSAP
    function animateSlides() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const slides = sliderEl.querySelectorAll('.product-slide');
      
      if (prefersReducedMotion) {
        slides.forEach(slide => {
          const image = slide.querySelector('.product-slide-image');
          const title = slide.querySelector('.product-slide-title');
          const viewAllBtn = slide.querySelector('.product-slide-view-all-btn');
          if (image) gsap.set(image, { opacity: 1 });
          if (title) gsap.set(title, { opacity: 1 });
          if (viewAllBtn) gsap.set(viewAllBtn, { opacity: 1 });
        });
        return;
      }

      slides.forEach((slide, index) => {
        const image = slide.querySelector('.product-slide-image');
        const title = slide.querySelector('.product-slide-title');
        const viewAllBtn = slide.querySelector('.product-slide-view-all-btn');

        // Reset
        if (image) {
          gsap.set(image, { clearProps: 'all' });
          gsap.set(image, { opacity: 1 });
        }
        if (title) {
          gsap.set(title, { clearProps: 'all' });
          gsap.set(title, { opacity: 1 });
        }
        if (viewAllBtn) {
          gsap.set(viewAllBtn, { clearProps: 'all' });
          gsap.set(viewAllBtn, { opacity: 1 });
        }

        // Get animation type
        const animType = slide.classList.contains('animate-from-left') ? 'fromLeft' :
                        slide.classList.contains('animate-from-right') ? 'fromRight' :
                        slide.classList.contains('animate-from-bottom') ? 'fromBottom' :
                        slide.classList.contains('animate-zoom-in') ? 'zoomIn' : 'fade';

        // Animate with stagger delay
        const delay = index * 0.2;

        // Animate image
        if (image) {
          animateElement(image, animType, delay);
        }

        // Animate title
        if (title) {
          animateElement(title, animType, delay + 0.3);
        }

        // Animate button
        if (viewAllBtn) {
          animateElement(viewAllBtn, animType, delay + 0.5);
        }
      });
    }

    function animateElement(element, type, delay) {
      if (!element) return;

      const duration = 1;
      const ease = 'power3.out';

      switch(type) {
        case 'fromLeft':
          gsap.fromTo(element,
            { opacity: 0, x: -100, filter: 'blur(10px)' },
            { opacity: 1, x: 0, filter: 'blur(0px)', duration, ease, delay }
          );
          break;
        case 'fromRight':
          gsap.fromTo(element,
            { opacity: 0, x: 100, filter: 'blur(10px)' },
            { opacity: 1, x: 0, filter: 'blur(0px)', duration, ease, delay }
          );
          break;
        case 'fromBottom':
          gsap.fromTo(element,
            { opacity: 0, y: 100, filter: 'blur(10px)' },
            { opacity: 1, y: 0, filter: 'blur(0px)', duration, ease, delay }
          );
          break;
        case 'zoomIn':
          gsap.fromTo(element,
            { opacity: 0, scale: 0.8 },
            { opacity: 1, scale: 1, duration, ease: 'back.out(1.7)', delay }
          );
          break;
        default: // fade
          gsap.fromTo(element,
            { opacity: 0, y: 30 },
            { opacity: 1, y: 0, duration, ease, delay }
          );
      }
    }

    // Initialize animations
    animateSlides();

    // Animate header elements
    const section = document.querySelector('.animated-product-slider-{{ section.id }}');
    if (section && typeof gsap !== 'undefined') {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      
      if (!prefersReducedMotion) {
        const heading = section.querySelector('.product-slider-heading');
        const description = section.querySelector('.product-slider-description');
        const viewAll = section.querySelector('.product-slider-view-all');

        function getAnimationType(animSetting) {
          if (animSetting.includes('from-left')) return 'fromLeft';
          if (animSetting.includes('from-right')) return 'fromRight';
          if (animSetting.includes('from-bottom')) return 'fromBottom';
          if (animSetting.includes('zoom-in')) return 'zoomIn';
          return 'fade';
        }

        if (heading) {
          animateElement(heading, getAnimationType('{{ section.settings.heading_animation }}'), 0);
        }
        if (description) {
          animateElement(description, getAnimationType('{{ section.settings.description_animation }}'), 0.2);
        }
        if (viewAll) {
          animateElement(viewAll, getAnimationType('{{ section.settings.view_all_animation }}'), 0.4);
        }
      } else {
        // Just show elements if reduced motion
        const heading = section.querySelector('.product-slider-heading');
        const description = section.querySelector('.product-slider-description');
        const viewAll = section.querySelector('.product-slider-view-all');
        if (heading) gsap.set(heading, { opacity: 1 });
        if (description) gsap.set(description, { opacity: 1 });
        if (viewAll) gsap.set(viewAll, { opacity: 1 });
      }
    }
  });
</script>

