          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name (Optional)",
          "info": "For accessibility"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Animated Brand Carousel",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
