<style>
  .animated-brand-carousel-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  .brand-carousel-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .brand-carousel-heading {
    text-align: center;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    margin-bottom: {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    line-height: 1.3;
    letter-spacing: -0.5px;
  }

  .brand-carousel-wrapper {
    position: relative;
    overflow: hidden;
    margin-top: {{ section.settings.carousel_top_spacing }}px;
    padding: 0 20px;
  }

  .brand-carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: brand-marquee-{{ section.id }} 25s linear infinite;
  }

  .brand-carousel-track:hover {
    animation-play-state: paused;
  }

  .brand-carousel-item {
    flex-shrink: 0;
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    border-radius: {{ section.settings.logo_border_radius }}px;
    padding: {{ section.settings.logo_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .brand-carousel-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale({{ section.settings.logo_grayscale }}%);
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .brand-carousel-item:hover img {
    filter: grayscale(0%);
    transform: scale(1.05);
  }

  @keyframes brand-marquee-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .animated-brand-carousel-{{ section.id }} {
      padding: 50px 15px 50px;
    }

    .brand-carousel-heading {
      font-size: clamp(24px, 5vw, 32px);
      margin-bottom: 30px;
    }

    .brand-carousel-wrapper {
      padding: 0 10px;
    }

    .brand-carousel-item {
      width: {{ section.settings.logo_width | times: 0.75 }}px;
      height: {{ section.settings.logo_height | times: 0.75 }}px;
      padding: {{ section.settings.logo_padding | times: 0.75 }}px;
    }
  }

  @media (max-width: 480px) {
    .brand-carousel-item {
      width: {{ section.settings.logo_width | times: 0.65 }}px;
      height: {{ section.settings.logo_height | times: 0.65 }}px;
      padding: {{ section.settings.logo_padding | times: 0.65 }}px;
    }
  }
</style>

<section class="animated-brand-carousel-{{ section.id }}">
  <div class="brand-carousel-container">
    {% if section.settings.heading != blank %}
      <h2 class="brand-carousel-heading wow animate__animated">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="brand-carousel-wrapper">
      <div class="brand-carousel-track">
        {% comment %}
          First sequence of logos
        {% endcomment %}
        {% for block in section.blocks %}
          {% if block.settings.logo != blank %}
            <div class="brand-carousel-item" {{ block.shopify_attributes }}>
              {{
                block.settings.logo
                | image_url: width: 300
                | image_tag: loading: 'lazy', alt: block.settings.brand_name | default: 'Brand logo'
              }}
            </div>
          {% endif %}
        {% endfor %}

        {% comment %}
          Second sequence of logos to create seamless circular loop
        {% endcomment %}
        {% for block in section.blocks %}
          {% if block.settings.logo != blank %}
            <div class="brand-carousel-item">
              {{
                block.settings.logo
                | image_url: width: 300
                | image_tag: loading: 'lazy', alt: block.settings.brand_name | default: 'Brand logo'
              }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.animated-brand-carousel-{{ section.id }}');
    if (!section) return;

    // Light GSAP intro animations on scroll
    if (typeof gsap !== 'undefined') {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        const heading = section.querySelector('.brand-carousel-heading');
        const items = section.querySelectorAll('.brand-carousel-item');

        if (heading && typeof ScrollTrigger !== 'undefined') {
          gsap.fromTo(
            heading,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: heading,
                start: 'top 80%',
                toggleActions: 'play none none none',
                once: true
              }
            }
          );
        }

        if (items.length && typeof ScrollTrigger !== 'undefined') {
          items.forEach((item) => {
            gsap.fromTo(
              item,
              { opacity: 0, y: 20 },
              {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: 'power3.out',
                scrollTrigger: {
                  trigger: item,
                  start: 'top 90%',
                  toggleActions: 'play none none none',
                  once: true
                }
              }
            );
          });
        }
      }
    }
  });
</script>

{% schema %}
{
  "name": "Animated Brand Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
