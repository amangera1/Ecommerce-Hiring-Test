<style>
  .animated-cta-section-{{ section.id }} {
    padding: 100px 20px;
    background: {{ section.settings.background_color }};
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  .cta-parallax-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .cta-background-image {
    width: 100%;
    height: 110%;
    object-fit: cover;
    will-change: transform;
    position: absolute;
    top: -5%;
    left: 0;
  }

  .cta-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .cta-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .cta-heading {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 700;
    margin-bottom: 24px;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }

  .cta-description {
    font-size: clamp(18px, 3vw, 22px);
    color: {{ section.settings.text_color }};
    margin-bottom: 40px;
    line-height: 1.6;
    opacity: 0.95;
  }

  .cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: 18px 40px;
    text-decoration: none;
    font-size: 18px;
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cta-button-primary {
    background: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text_color }};
  }

  .cta-button-primary:hover {
    background: {{ section.settings.primary_button_hover }};
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }

  .cta-button-secondary {
    background: transparent;
    color: {{ section.settings.secondary_button_text_color }};
    border: 2px solid {{ section.settings.secondary_button_border }};
  }

  .cta-button-secondary:hover {
    background: {{ section.settings.secondary_button_bg }};
    color: {{ section.settings.secondary_button_hover_text }};
    transform: translateY(-3px);
  }

  .cta-features {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 60px;
    flex-wrap: wrap;
  }

  .cta-feature {
    display: flex;
    align-items: center;
    gap: 12px;
    color: {{ section.settings.text_color }};
  }

  .cta-feature-icon {
    font-size: 24px;
  }

  .cta-feature-text {
    font-size: 16px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .animated-cta-section-{{ section.id }} {
      padding: 80px 15px;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-button {
      width: 100%;
      text-align: center;
    }

    .cta-features {
      flex-direction: column;
      gap: 20px;
    }
  }
</style>

<section class="animated-cta-section-{{ section.id }}">
  {% if section.settings.background_image != blank %}
    <div class="cta-parallax-container">
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag: class: 'cta-background-image parallax-bg', loading: 'lazy'
      }}
      <div class="cta-overlay"></div>
    </div>
  {% endif %}

  <div class="cta-container">
    {% if section.settings.heading != blank %}
      <h2 class="cta-heading gsap-zoom-in wow animate__animated">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="cta-description gsap-fade-in wow animate__animated">{{ section.settings.description }}</p>
    {% endif %}

    <div class="cta-buttons">
      {% if section.settings.primary_button_text != blank and section.settings.primary_button_link != blank %}
        <a href="{{ section.settings.primary_button_link }}" class="cta-button cta-button-primary gsap-button-enter gsap-bounce-hover wow animate__animated">
          {{ section.settings.primary_button_text }}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_text != blank and section.settings.secondary_button_link != blank %}
        <a href="{{ section.settings.secondary_button_link }}" class="cta-button cta-button-secondary gsap-button-enter gsap-bounce-hover wow animate__animated">
          {{ section.settings.secondary_button_text }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.show_features %}
      <div class="cta-features">
        {% for block in section.blocks %}
          <div class="cta-feature gsap-fade-in wow animate__animated" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <span class="cta-feature-icon">{{ block.settings.icon }}</span>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="cta-feature-text">{{ block.settings.text }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Animated CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Get Started?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join thousands of satisfied customers today"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show Features",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "color",
      "id": "primary_button_bg",
      "label": "Primary Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_button_text_color",
      "label": "Primary Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "primary_button_hover",
      "label": "Primary Button Hover",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "secondary_button_text_color",
      "label": "Secondary Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_border",
      "label": "Secondary Button Border",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_bg",
      "label": "Secondary Button Hover Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_hover_text",
      "label": "Secondary Button Hover Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Free Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Animated CTA",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "🚚",
            "text": "Free Shipping"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "↩️",
            "text": "Easy Returns"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🔒",
            "text": "Secure Checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}

