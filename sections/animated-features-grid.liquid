<style>
  .animated-features-grid-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  .features-grid-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  {% if section.settings.show_section_heading %}
    .features-section-heading {
      text-align: {{ section.settings.heading_alignment }};
      margin-bottom: {{ section.settings.heading_spacing }}px;
    }

    .features-section-title {
      font-size: clamp(32px, 5vw, {{ section.settings.heading_size }}px);
      font-weight: {{ section.settings.heading_weight }};
      color: {{ section.settings.heading_color }};
      margin-bottom: 16px;
      line-height: 1.3;
    }

    .features-section-subtitle {
      font-size: clamp(16px, 2vw, {{ section.settings.subtitle_size }}px);
      color: {{ section.settings.subtitle_color }};
      line-height: 1.6;
      max-width: 700px;
      margin: 0 auto;
    }
  {% endif %}

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.card_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .feature-card {
    background: {{ section.settings.card_bg_color }};
    padding: 40px 20px;
    border-radius: 0;
    text-align: left;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    box-shadow: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-card-inner {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
  }

  .feature-card:hover {
    transform: translateY(-5px);
  }

  .feature-icon-wrapper {
    width: 100px;
    height: 100px;
    min-width: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.icon_bg_color }};
    border-radius: 50%;
    position: relative;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .feature-card:hover .feature-icon-wrapper {
    transform: scale(1.1) rotate(5deg);
  }

  .feature-icon-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .feature-icon-text {
    font-size: 40px;
    color: {{ section.settings.icon_color }};
  }

  .feature-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .feature-title {
    font-size: clamp(18px, 2.5vw, 22px);
    font-weight: 700;
    margin: 0 0 12px 0;
    color: {{ section.settings.title_color }};
    line-height: 1.3;
    text-align: left;
  }

  .feature-description {
    font-size: clamp(14px, 1.8vw, 16px);
    line-height: 1.6;
    color: {{ section.settings.description_color }};
    margin: 0;
    text-align: left;
    max-width: 100%;
  }

  /* Animation Classes - Section specific to avoid conflicts */
  .animated-features-grid-{{ section.id }} .animate-from-left,
  .animated-features-grid-{{ section.id }} .animate-from-right,
  .animated-features-grid-{{ section.id }} .animate-from-bottom,
  .animated-features-grid-{{ section.id }} .animate-from-top,
  .animated-features-grid-{{ section.id }} .animate-zoom-in,
  .animated-features-grid-{{ section.id }} .animate-fade {
    /* GSAP will handle opacity and transforms */
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .animated-features-grid-{{ section.id }} {
      padding: 60px 15px 60px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .feature-card {
      padding: 30px 20px;
    }

    .feature-card-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }

    .feature-icon-wrapper {
      margin: 0;
    }

    .feature-content {
      align-items: center;
      text-align: center;
    }

    .feature-title {
      text-align: center;
    }

    .feature-description {
      text-align: center;
    }
  }
</style>

<section class="animated-features-grid-{{ section.id }}">
  <div class="features-grid-container">

    <div class="features-grid">
      {% for block in section.blocks %}
        <div
          class="feature-card animate-{{ block.settings.card_animation | default: section.settings.default_card_animation }} wow animate__animated"
          {{ block.shopify_attributes }}
        >
          <div class="feature-card-inner">
            <div class="feature-icon-wrapper">
              {% if block.settings.icon_image != blank %}
                {{
                  block.settings.icon_image
                  | image_url: width: 200
                  | image_tag: class: 'feature-icon-image', loading: 'lazy', alt: block.settings.title
                }}
              {% elsif block.settings.icon_text != blank %}
                <span class="feature-icon-text">{{ block.settings.icon_text }}</span>
              {% endif %}
            </div>
            <div class="feature-content">
              {% if block.settings.title != blank %}
                <h3 class="feature-title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="feature-description">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.animated-features-grid-{{ section.id }}');
    if (!section || typeof gsap === 'undefined') return;

    // Check for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Animate feature cards with stagger
    const featureCards = section.querySelectorAll('.feature-card');
    if (featureCards.length > 0) {
      const defaultAnimation = '{{ section.settings.default_card_animation }}';
      const staggerDelay = 0.2;

      featureCards.forEach((card, index) => {
        const cardAnimation = card.classList.contains('animate-from-left') ? 'from-left' :
                             card.classList.contains('animate-from-right') ? 'from-right' :
                             card.classList.contains('animate-from-bottom') ? 'from-bottom' :
                             card.classList.contains('animate-from-top') ? 'from-top' :
                             card.classList.contains('animate-zoom-in') ? 'zoom-in' :
                             card.classList.contains('animate-fade') ? 'fade' : defaultAnimation;

        const delay = index * staggerDelay;
        animateElement(card, cardAnimation, delay, prefersReducedMotion);
      });
    }

    function animateElement(element, type, delay, reducedMotion) {
      if (!element) return;

      if (reducedMotion) {
        // Simple fade for reduced motion
        gsap.to(element, { opacity: 1, duration: 0.6, delay: delay * 0.5 });
        return;
      }

      const duration = 1;
      const ease = 'power3.out';

      switch(type) {
        case 'from-left':
          gsap.fromTo(element,
            { opacity: 0, x: -100, filter: 'blur(10px)', scale: 0.9 },
            { opacity: 1, x: 0, filter: 'blur(0px)', scale: 1, duration, ease, delay }
          );
          break;
        case 'from-right':
          gsap.fromTo(element,
            { opacity: 0, x: 100, filter: 'blur(10px)', scale: 0.9 },
            { opacity: 1, x: 0, filter: 'blur(0px)', scale: 1, duration, ease, delay }
          );
          break;
        case 'from-bottom':
          gsap.fromTo(element,
            { opacity: 0, y: 100, filter: 'blur(10px)', scale: 0.9 },
            { opacity: 1, y: 0, filter: 'blur(0px)', scale: 1, duration, ease, delay }
          );
          break;
        case 'from-top':
          gsap.fromTo(element,
            { opacity: 0, y: -100, filter: 'blur(10px)', scale: 0.9 },
            { opacity: 1, y: 0, filter: 'blur(0px)', scale: 1, duration, ease, delay }
          );
          break;
        case 'zoom-in':
          gsap.fromTo(element,
            { opacity: 0, scale: 0.3, rotation: -10 },
            { opacity: 1, scale: 1, rotation: 0, duration, ease: 'back.out(1.7)', delay }
          );
          break;
        default: // fade
          gsap.fromTo(element,
            { opacity: 0, y: 50, scale: 0.95 },
            { opacity: 1, y: 0, scale: 1, duration, ease, delay }
          );
      }
    }

    // Animate icons separately for extra effect
    const iconWrappers = section.querySelectorAll('.feature-icon-wrapper');
    iconWrappers.forEach((icon, index) => {
      const card = icon.closest('.feature-card');
      if (card) {
        gsap.fromTo(icon,
          { opacity: 0, scale: 0, rotation: -180 },
          {
            opacity: 1,
            scale: 1,
            rotation: 0,
            duration: 0.8,
            ease: 'back.out(1.7)',
            delay: (index * 0.2) + 0.3,
            scrollTrigger: {
              trigger: card,
              start: 'top 85%',
              toggleActions: 'play none none reverse',
              once: true
            }
          }
        );
      }
    });
  });
</script>

