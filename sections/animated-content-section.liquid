<style>
  .animated-content-section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  {% if section.settings.background_image != blank %}
    .animated-content-section-{{ section.id }} {
      background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: {{ section.settings.parallax_enabled }} ? fixed : scroll;
    }
    
    .content-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: {{ section.settings.overlay_color }};
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      z-index: 0;
    }
  {% endif %}

  .content-container {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    text-align: {{ section.settings.text_alignment }};
    position: relative;
    z-index: 1;
  }

  .content-heading {
    font-size: clamp(28px, 5vw, {{ section.settings.heading_size }}px);
    font-weight: {{ section.settings.heading_weight }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    line-height: 1.3;
  }

  .content-description {
    font-size: clamp(16px, 2vw, {{ section.settings.description_size }}px);
    margin-bottom: {{ section.settings.description_spacing }}px;
    color: {{ section.settings.text_color }};
    line-height: {{ section.settings.description_line_height }};
    max-width: 100%;
  }

  .content-button-wrapper {
    margin-top: {{ section.settings.button_spacing }}px;
    display: flex;
    justify-content: {{ section.settings.button_alignment }};
    flex-wrap: wrap;
    gap: 15px;
  }

  .content-button {
    display: inline-block;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    border-radius: {{ section.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    position: relative;
    overflow: hidden;
  }

  .content-button:hover {
    background: {{ section.settings.button_hover_bg }};
    color: {{ section.settings.button_hover_text }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    border-color: {{ section.settings.button_hover_border }};
  }

  /* Animation Classes - Section specific to avoid conflicts */
  .animated-content-section-{{ section.id }} .animate-from-left,
  .animated-content-section-{{ section.id }} .animate-from-right,
  .animated-content-section-{{ section.id }} .animate-from-bottom,
  .animated-content-section-{{ section.id }} .animate-from-top,
  .animated-content-section-{{ section.id }} .animate-zoom-in,
  .animated-content-section-{{ section.id }} .animate-fade {
    /* GSAP will handle opacity and transforms */
  }

  @media (max-width: 768px) {
    .animated-content-section-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 15px {{ section.settings.mobile_padding_bottom }}px;
    }

    .content-button-wrapper {
      flex-direction: column;
      align-items: center;
    }

    .content-button {
      width: 100%;
      max-width: 300px;
      text-align: center;
    }
  }
</style>

<section class="animated-content-section-{{ section.id }}">
  {% if section.settings.background_image != blank %}
    <div class="content-overlay"></div>
  {% endif %}

  <div class="content-container">
    {% if section.settings.heading != blank %}
      <h2 class="content-heading animate-{{ section.settings.heading_animation }} wow animate__animated">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="content-description animate-{{ section.settings.description_animation }} wow animate__animated">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <div class="content-button-wrapper">
        <a href="{{ section.settings.button_link }}" class="content-button animate-{{ section.settings.button_animation }} gsap-bounce-hover wow animate__animated">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.animated-content-section-{{ section.id }}');
    if (!section || typeof gsap === 'undefined') return;

    // Check for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      // Just fade in if reduced motion
      const animElements = section.querySelectorAll('.animate-from-left, .animate-from-right, .animate-from-bottom, .animate-from-top, .animate-zoom-in, .animate-fade');
      animElements.forEach(el => {
        gsap.to(el, { opacity: 1, duration: 0.8, delay: 0.2 });
      });
      return;
    }

    // Animate heading
    const heading = section.querySelector('.content-heading');
    if (heading) {
      animateElement(heading, '{{ section.settings.heading_animation }}', 0);
    }

    // Animate description
    const description = section.querySelector('.content-description');
    if (description) {
      animateElement(description, '{{ section.settings.description_animation }}', 0.3);
    }

    // Animate button
    const button = section.querySelector('.content-button');
    if (button) {
      animateElement(button, '{{ section.settings.button_animation }}', 0.6);
    }

    function animateElement(element, type, delay) {
      if (!element) return;

      const duration = 1;
      const ease = 'power3.out';

      switch(type) {
        case 'from-left':
          gsap.fromTo(element,
            { opacity: 0, x: -100, filter: 'blur(10px)' },
            { opacity: 1, x: 0, filter: 'blur(0px)', duration, ease, delay }
          );
          break;
        case 'from-right':
          gsap.fromTo(element,
            { opacity: 0, x: 100, filter: 'blur(10px)' },
            { opacity: 1, x: 0, filter: 'blur(0px)', duration, ease, delay }
          );
          break;
        case 'from-bottom':
          gsap.fromTo(element,
            { opacity: 0, y: 100, filter: 'blur(10px)' },
            { opacity: 1, y: 0, filter: 'blur(0px)', duration, ease, delay }
          );
          break;
        case 'from-top':
          gsap.fromTo(element,
            { opacity: 0, y: -100, filter: 'blur(10px)' },
            { opacity: 1, y: 0, filter: 'blur(0px)', duration, ease, delay }
          );
          break;
        case 'zoom-in':
          gsap.fromTo(element,
            { opacity: 0, scale: 0.5, y: 50 },
            { opacity: 1, scale: 1, y: 0, duration, ease: 'back.out(1.7)', delay }
          );
          break;
        default: // fade
          gsap.fromTo(element,
            { opacity: 0, y: 30 },
            { opacity: 1, y: 0, duration, ease, delay }
          );
      }
    }

    // Parallax effect for background if enabled
    {% if section.settings.parallax_enabled and section.settings.background_image != blank %}
      if (typeof ScrollTrigger !== 'undefined') {
        const bgImage = section;
        gsap.to(bgImage, {
          backgroundPositionY: '30%',
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.5
          }
        });
      }
    {% endif %}
  });
</script>

