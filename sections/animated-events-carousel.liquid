<style>
  .animated-events-carousel-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  .events-carousel-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .events-carousel-heading {
    text-align: center;
    font-size: clamp(24px, 4vw, 30px);
    font-weight: 600;
    margin-top: 0;
    margin-bottom: {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    line-height: 1.3;
    letter-spacing: -0.5px;
  }

  .events-carousel-wrapper {
    position: relative;
    overflow: hidden;
    margin-top: {{ section.settings.carousel_top_spacing }}px;
    padding: 0 20px;
  }

  .events-carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: {{ section.settings.item_gap }}px;
    animation: events-marquee-{{ section.id }} 30s linear infinite;
  }

  .events-carousel-track:hover {
    animation-play-state: paused;
  }

  .events-carousel-item {
    flex-shrink: 0;
    min-width: {{ section.settings.item_width }}px;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px;
    background: {{ section.settings.item_background }};
    border-radius: {{ section.settings.item_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .events-carousel-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .events-carousel-icon {
    flex-shrink: 0;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .events-carousel-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .events-carousel-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .events-carousel-text {
    font-size: {{ section.settings.text_size }}px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    line-height: 1.4;
    margin: 0;
  }

  .events-carousel-date {
    font-size: {{ section.settings.date_size }}px;
    font-weight: 400;
    color: {{ section.settings.date_color }};
    line-height: 1.3;
    margin: 0;
  }

  @keyframes events-marquee-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .animated-events-carousel-{{ section.id }} {
      padding: 50px 15px 50px;
    }

    .events-carousel-heading {
      font-size: clamp(24px, 5vw, 32px);
      margin-bottom: 30px;
    }

    .events-carousel-wrapper {
      padding: 0 10px;
    }

    .events-carousel-item {
      min-width: {{ section.settings.item_width | times: 0.85 }}px;
      padding: 15px;
      gap: 12px;
    }

    .events-carousel-icon {
      width: {{ section.settings.icon_size | times: 0.85 }}px;
      height: {{ section.settings.icon_size | times: 0.85 }}px;
    }

    .events-carousel-text {
      font-size: {{ section.settings.text_size | times: 0.9 }}px;
    }

    .events-carousel-date {
      font-size: {{ section.settings.date_size | times: 0.9 }}px;
    }
  }

  @media (max-width: 480px) {
    .events-carousel-item {
      min-width: {{ section.settings.item_width | times: 0.75 }}px;
      padding: 12px;
      gap: 10px;
    }

    .events-carousel-icon {
      width: {{ section.settings.icon_size | times: 0.75 }}px;
      height: {{ section.settings.icon_size | times: 0.75 }}px;
    }

    .events-carousel-text {
      font-size: {{ section.settings.text_size | times: 0.85 }}px;
    }

    .events-carousel-date {
      font-size: {{ section.settings.date_size | times: 0.85 }}px;
    }
  }
</style>

<section class="animated-events-carousel-{{ section.id }}">
  <div class="events-carousel-container">
    {% if section.settings.heading != blank %}
      <h2 class="events-carousel-heading wow animate__animated">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="events-carousel-wrapper">
      <div class="events-carousel-track">
        {% comment %}
          First sequence of events
        {% endcomment %}
        {% for block in section.blocks %}
          {% if block.settings.event_text != blank or block.settings.event_date != blank %}
            <div class="events-carousel-item" {{ block.shopify_attributes }}>
              {% if block.settings.icon_image != blank %}
                <div class="events-carousel-icon">
                  {{
                    block.settings.icon_image
                    | image_url: width: 100
                    | image_tag: loading: 'lazy', alt: block.settings.event_text | default: 'Event icon'
                  }}
                </div>
              {% endif %}
              <div class="events-carousel-content">
                {% if block.settings.event_text != blank %}
                  <p class="events-carousel-text">{{ block.settings.event_text }}</p>
                {% endif %}
                {% if block.settings.event_date != blank %}
                  <p class="events-carousel-date">{{ block.settings.event_date }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% comment %}
          Second sequence of events to create seamless circular loop
        {% endcomment %}
        {% for block in section.blocks %}
          {% if block.settings.event_text != blank or block.settings.event_date != blank %}
            <div class="events-carousel-item">
              {% if block.settings.icon_image != blank %}
                <div class="events-carousel-icon">
                  {{
                    block.settings.icon_image
                    | image_url: width: 100
                    | image_tag: loading: 'lazy', alt: block.settings.event_text | default: 'Event icon'
                  }}
                </div>
              {% endif %}
              <div class="events-carousel-content">
                {% if block.settings.event_text != blank %}
                  <p class="events-carousel-text">{{ block.settings.event_text }}</p>
                {% endif %}
                {% if block.settings.event_date != blank %}
                  <p class="events-carousel-date">{{ block.settings.event_date }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.animated-events-carousel-{{ section.id }}');
    if (!section) return;

    // Light GSAP intro animations on scroll
    if (typeof gsap !== 'undefined') {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        const heading = section.querySelector('.events-carousel-heading');
        const items = section.querySelectorAll('.events-carousel-item');

        if (heading && typeof ScrollTrigger !== 'undefined') {
          gsap.fromTo(
            heading,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: heading,
                start: 'top 80%',
                toggleActions: 'play none none none',
                once: true
              }
            }
          );
        }

        if (items.length && typeof ScrollTrigger !== 'undefined') {
          items.forEach((item) => {
            gsap.fromTo(
              item,
              { opacity: 0, x: 30 },
              {
                opacity: 1,
                x: 0,
                duration: 0.6,
                ease: 'power3.out',
                scrollTrigger: {
                  trigger: item,
                  start: 'top 90%',
                  toggleActions: 'play none none none',
                  once: true
                }
              }
            );
          });
        }
      }
    }
  });
</script>

